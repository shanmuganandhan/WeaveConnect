# ==========================================================
# WeaveConnect - root .gitignore
# ==========================================================

# --- Secrets and environment variables ---
# Real .env files must never be committed. Only the
# ".env.example" templates (which contain placeholders) are tracked.
.env
.env.*
!.env.example

# --- Node / dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# --- Build output ---
dist/
build/
.vite/
.cache/

# --- Test and coverage output ---
coverage/
*.lcov

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Editor / OS files ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Local environment overrides ---
.env.local
.env.*.local
