PORT=5000
MONGODB_URI=mongodb://localhost:27017/weaveconnect


JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
# Short-lived access token (refresh token keeps using JWT_EXPIRE).
JWT_ACCESS_EXPIRE=15m


CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# Gmail SMTP — use a Google APP PASSWORD, never your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_address@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_FROM=your_email_address@gmail.com


# Razorpay TEST MODE keys (Dashboard -> Settings -> API Keys).
# The secret stays server-side only and must never be committed.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Separate secret shown when you add the webhook in the Razorpay dashboard.
# Point the webhook at POST https://<your-api-host>/api/payment/webhook and
# subscribe to payment.captured, order.paid and payment.failed.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# Optional: comma-separated list of allowed frontend origins.
# Leave empty to allow all origins (previous behaviour).
CORS_ORIGIN=

# Optional rate-limit tuning (requests per window per key).
#AUTH_RATE_LIMIT_MAX=200
#LOGIN_RATE_LIMIT_MAX=8
#OTP_RATE_LIMIT_MAX=3
#OTP_VERIFY_RATE_LIMIT_MAX=8
#PAYMENT_RATE_LIMIT_MAX=30
